diff --git a/lib/bdev/bdev.c b/lib/bdev/bdev.c
index 1d040c5..cb1519f 100644
--- a/lib/bdev/bdev.c
+++ b/lib/bdev/bdev.c
@@ -631,8 +631,14 @@ spdk_bdev_wait_for_examine(spdk_bdev_wait_for_examine_cb cb_fn, void *cb_arg)
 	}
 	ctx->cb_fn = cb_fn;
 	ctx->cb_arg = cb_arg;
-	ctx->poller = SPDK_POLLER_REGISTER(bdev_wait_for_examine_cb, ctx, 0);
-	spdk_poller_register_interrupt(ctx->poller, NULL, NULL);
+	/* Use a periodic poller (1 ms) instead of a busy poller. In interrupt
+	 * mode a busy poller (period=0) gets an always-readable eventfd that
+	 * spins the reactor; clearing it via spdk_poller_register_interrupt(NULL,
+	 * NULL) leaves the poller with no interrupt source so it never fires
+	 * and bdev examine never completes. A periodic poller installs a
+	 * timerfd that fires every 1 ms in both poll and interrupt modes — fast
+	 * enough for examine completion which is normally microseconds. */
+	ctx->poller = SPDK_POLLER_REGISTER(bdev_wait_for_examine_cb, ctx, 1000);
 
 	return 0;
 }
